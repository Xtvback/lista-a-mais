{
  "name": "apee-associados",
  "main": "associados-worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://apeebairrodorestelo.com",
    "API_ORIGIN": "https://associados-api.apeebairrodorestelo.com"
  },
  "d1_databases": [{"binding":"DB","database_name":"apee-associados","database_id":"REPLACE_AFTER_CREATION","migrations_dir":"../migrations"}],
  "r2_buckets": [{"binding":"DOCS","bucket_name":"apee-documentos-privados"}],
  "triggers": {"crons":["17 3 * * *"]}
}
